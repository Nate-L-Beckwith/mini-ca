# Copy to .env and adjust, or let `python3 genenv.py` generate it with random passwords.
# Compose reads this file for ${VAR} interpolation; secrets are passed only to the
# services that need them (see docker-compose.yml).

### mini-ca #############################################################
# image used by docker-compose.yml (point at a local build with e.g. minica:dev)
MINICA_IMAGE=ghcr.io/nate-l-beckwith/mini-ca:latest
# MINICA_CA_NAME=mini-ca root
# MINICA_LEAF_DAYS=825
# MINICA_RENEW_DAYS=30

### Global ###############################################################
TZ=America/New_York
DOCKERHOST=192.168.1.10

### MariaDB (used by NPM) ################################################
DB_MYSQL_HOST=db
DB_MYSQL_PORT=3306
DB_MYSQL_USER=npm
DB_MYSQL_NAME=npm
MYSQL_ROOT_PASSWORD=change-me-root
DB_MYSQL_PASSWORD=change-me-db

### Nginx-Proxy-Manager ##################################################
NPM_CONTAINER_NAME=npm
# NPM >= 2.13 has no default admin; these create it when its database is first created
INITIAL_ADMIN_EMAIL=admin@npm
INITIAL_ADMIN_PASSWORD=change-me-admin
# credentials cert-sync uses for the NPM API — update if you change the admin password in the UI
NPM_INITIAL_PASSWORD=change-me-admin
# set to true on hosts without IPv6 ("Address family not supported by protocol" in NPM logs)
DISABLE_IPV6=false

# host-port bindings (host-ip:host-port:container-port)
NPM_PORT=192.168.1.10:80:80
NPM_UI_PORT=192.168.1.10:81:81
NPM_S_PORTS=192.168.1.10:443:443
